# Frontend configuration.
# The AI pipeline + Azure key now live in the backend service (see server/.env.example).
# Point the frontend at that backend:
VITE_API_BASE_URL=http://localhost:8080

# Real per-user login replaced the old shared passcode gate. Registration is
# controlled server-side via REGISTRATION_INVITE_CODE (see server/.env.example)
# — there is no frontend-only lock to configure any more.
