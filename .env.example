# Azure OpenAI configuration.
# Portal: Azure AI Foundry / Azure OpenAI resource → Keys and Endpoint.

# Resource endpoint, e.g. https://<your-resource>.openai.azure.com/
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# One of the two keys from "Keys and Endpoint".
VITE_AZURE_OPENAI_API_KEY=your-azure-openai-key

# DEPLOYMENT name (Azure Portal → resource → Deployments). This is the name YOU
# gave the deployment, which may differ from the underlying model name.
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# REST API version. 2024-10-21 is a stable GA version for chat completions.
# Use a newer preview for reasoning models (reasoning_effort / max_completion_tokens).
VITE_AZURE_OPENAI_API_VERSION=2024-10-21
